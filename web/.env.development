# 本地环境
ENV = 'development'

# base路径
VITE_BASE_PATH = './'

# 本地环境接口地址 - 尾部无需带'/'
# 本地开发走 vite server.proxy 代理（见 vite.config.ts），直接使用当前域名
# VITE_AXIOS_BASE_URL = 'http://localhost:8030'
VITE_AXIOS_BASE_URL = 'getCurrentDomain'

# 本地开发代理目标服务器（vite.config.ts 中 /api、/admin、/storage 的代理地址）- 尾部无需带'/'
VITE_PROXY_TARGET = 'http://localhost:8030'
